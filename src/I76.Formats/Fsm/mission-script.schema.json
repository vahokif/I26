{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/vahokif/I26/master/src/I76.Formats/Fsm/mission-script.schema.json",
  "title": "I26 mission script",
  "description": "An Interstate '76 mission script (the FSM chunk of a .msn/.lvl) as source. See docs/mission-scripts.md.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "mission": { "type": "string", "description": "The mission it was decompiled from (a note)." },
    "prototypes": {
      "type": "array", "items": { "type": "string" },
      "description": "The operation table, only when it is not the stock one."
    },
    "actors": {
      "type": "object", "description": "The actor table, in order: key -> the placed object it names.",
      "propertyNames": { "$ref": "#/definitions/key" },
      "additionalProperties": {
        "anyOf": [
          { "type": "string", "description": "The placement's object name (its id found among the mission's placements)." },
          {
            "type": "object", "additionalProperties": false,
            "properties": {
              "label": { "type": "string", "maxLength": 39, "description": "The script's label when it is not the key." },
              "object": { "type": "string", "description": "The placement's name without its high bits." },
              "id": { "type": "string", "pattern": "^[0-9A-Fa-f ]{16,23}$", "description": "The placement's 8-byte name, high bits included, as 16 hex digits." },
              "alias": { "$ref": "#/definitions/text" },
              "description": { "$ref": "#/definitions/text" }
            }
          }
        ]
      }
    },
    "paths": {
      "type": "object", "description": "The nav-path table, in order (reference only: paths are edited with the path tool).",
      "propertyNames": { "$ref": "#/definitions/key" },
      "additionalProperties": {
        "anyOf": [
          { "type": "null" },
          { "type": "string", "description": "The label, when it is not the key." },
          {
            "type": "object", "additionalProperties": false,
            "properties": {
              "label": { "type": "string" },
              "points": { "type": "integer", "minimum": 0 },
              "description": { "$ref": "#/definitions/text" }
            }
          }
        ]
      }
    },
    "sounds": {
      "type": "object", "description": "The sounds (and movies) table, in order: key -> file name.",
      "propertyNames": { "$ref": "#/definitions/key" },
      "additionalProperties": {
        "anyOf": [
          { "type": "string", "maxLength": 39 },
          {
            "type": "object", "additionalProperties": false, "required": ["file"],
            "properties": { "file": { "type": "string", "maxLength": 39 }, "description": { "$ref": "#/definitions/text" } }
          }
        ]
      }
    },
    "globals": {
      "type": "object", "description": "The data cells, in order: name -> initial value. Threads bind script fields to them.",
      "propertyNames": { "$ref": "#/definitions/identifier" },
      "additionalProperties": {
        "anyOf": [
          { "$ref": "#/definitions/value" },
          {
            "type": "object", "additionalProperties": false, "required": ["value"],
            "properties": { "value": { "$ref": "#/definitions/value" }, "description": { "$ref": "#/definitions/text" } }
          }
        ]
      }
    },
    "scripts": {
      "type": "object", "description": "The routines, in code order.",
      "propertyNames": { "$ref": "#/definitions/identifier" },
      "additionalProperties": { "$ref": "#/definitions/script" }
    },
    "threads": {
      "type": "object", "description": "The threads, in run order: each runs a script with its fields bound to globals.",
      "propertyNames": { "$ref": "#/definitions/identifier" },
      "additionalProperties": { "$ref": "#/definitions/thread" }
    }
  },
  "definitions": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
    "key": { "type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$" },
    "text": { "type": ["string", "number", "boolean", "null"] },
    "value": {
      "description": "A number, or a table entry (actor.KEY, path.KEY, sound.KEY), which is its index there.",
      "anyOf": [
        { "type": "integer" },
        { "type": "string", "pattern": "^(-?[0-9]+|0x[0-9A-Fa-f]+|(actor|path|sound)\\.[A-Za-z0-9_][A-Za-z0-9_.-]*)$" }
      ]
    },
    "coderef": { "type": "string", "pattern": "^([A-Za-z_][A-Za-z0-9_]*(\\s*\\+\\s*[0-9]+)?|@[0-9]+)$", "description": "A script, script+N (an instruction inside it) or @N." },
    "action": {
      "anyOf": [
        { "type": "string", "pattern": "^\\s*[A-Za-z_][A-Za-z0-9_]*\\s*(\\(.*\\))?\\s*$", "description": "operation(arg, ...): args are fields, variables, *variable, numbers, actor.KEY, path.KEY, sound.KEY" },
        {
          "type": "object", "additionalProperties": false, "required": ["call"],
          "properties": {
            "call": { "$ref": "#/definitions/coderef" },
            "args": { "type": "array", "items": { "type": ["string", "integer"] } }
          }
        }
      ]
    },
    "actions": {
      "anyOf": [
        { "$ref": "#/definitions/action" },
        { "type": "array", "items": { "$ref": "#/definitions/action" } }
      ]
    },
    "condition": {
      "type": ["string", "boolean"],
      "description": "Calls of tests combined with !, &&, || and parentheses; a == b, a > b, a < b for isEqual, isGreater, isLesser; true."
    },
    "goto": {
      "type": "string",
      "description": "A step id, or stop (the thread ends), restart (this step again), next, continue, break (of the innermost repeat).",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "rule": {
      "type": "object", "additionalProperties": false, "required": ["when"],
      "properties": {
        "when": { "$ref": "#/definitions/condition" },
        "then": { "$ref": "#/definitions/actions" },
        "goto": { "$ref": "#/definitions/goto" },
        "steps": { "$ref": "#/definitions/steps", "description": "A branch: steps entered when this rule fires; they continue after the step that holds it." }
      }
    },
    "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/step" } },
    "step": {
      "anyOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["do"],
          "properties": {
            "id": { "$ref": "#/definitions/identifier" },
            "description": { "$ref": "#/definitions/text" },
            "do": { "$ref": "#/definitions/actions" },
            "goto": { "$ref": "#/definitions/goto" },
            "while_waiting": { "$ref": "#/definitions/actions" }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["wait_until"],
          "properties": {
            "id": { "$ref": "#/definitions/identifier" },
            "description": { "$ref": "#/definitions/text" },
            "wait_until": { "$ref": "#/definitions/condition" },
            "then": { "$ref": "#/definitions/actions" },
            "goto": { "$ref": "#/definitions/goto" },
            "while_waiting": { "$ref": "#/definitions/actions" }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["wait"],
          "properties": {
            "id": { "$ref": "#/definitions/identifier" },
            "description": { "$ref": "#/definitions/text" },
            "wait": { "type": "array", "items": { "$ref": "#/definitions/rule" } },
            "while_waiting": { "$ref": "#/definitions/actions" }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["repeat"],
          "properties": { "repeat": { "$ref": "#/definitions/steps" } }
        }
      ]
    },
    "variable": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/definitions/value" },
        {
          "type": "object", "additionalProperties": false,
          "properties": {
            "value": { "anyOf": [{ "type": "null" }, { "$ref": "#/definitions/value" }] },
            "description": { "$ref": "#/definitions/text" }
          }
        }
      ]
    },
    "script": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "alias": { "$ref": "#/definitions/text" },
        "description": { "$ref": "#/definitions/text" },
        "fields": {
          "type": "array", "description": "The parameters, in stack order (a thread binds each to a global).",
          "items": {
            "anyOf": [
              { "$ref": "#/definitions/identifier" },
              {
                "type": "object", "additionalProperties": false, "required": ["name"],
                "properties": { "name": { "$ref": "#/definitions/identifier" }, "description": { "$ref": "#/definitions/text" } }
              }
            ]
          }
        },
        "variables": {
          "type": "object", "description": "The locals: initial value, or null for none.",
          "propertyNames": { "$ref": "#/definitions/identifier" },
          "additionalProperties": { "$ref": "#/definitions/variable" }
        },
        "guards": { "type": "array", "items": { "$ref": "#/definitions/rule" }, "description": "Rules tested first in every step." },
        "steps": { "$ref": "#/definitions/steps" },
        "asm": { "type": "array", "items": { "type": "string" }, "description": "Raw instructions, for code that is not in the state-machine shape." }
      },
      "oneOf": [{ "required": ["steps"] }, { "required": ["asm"] }]
    },
    "thread": {
      "type": "object", "additionalProperties": false, "required": ["script"],
      "properties": {
        "script": { "$ref": "#/definitions/coderef" },
        "args": {
          "anyOf": [
            { "type": "object", "propertyNames": { "$ref": "#/definitions/identifier" }, "additionalProperties": { "$ref": "#/definitions/identifier" } },
            { "type": "array", "items": { "$ref": "#/definitions/identifier" } }
          ]
        },
        "alias": { "$ref": "#/definitions/text" },
        "description": { "$ref": "#/definitions/text" }
      }
    }
  }
}
