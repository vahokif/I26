<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <!-- the game's pure-managed pieces (the terrain's level-of-detail meshes), run without the engine: nothing here may touch a Godot node or the engine's natives -->
    <ProjectReference Include="../../game/I76.Game.csproj" />
    <Compile Include="../I76.Formats.Tests/InstallFact.cs" Link="InstallFact.cs" />
  </ItemGroup>
</Project>
