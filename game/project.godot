; Engine configuration file.

config_version=5

[application]

config/name="I26"
config/icon="res://Assets/icon.svg"
config/use_custom_user_dir=true
config/custom_user_dir_name="I26"
config/project_settings_override="user://log_settings.cfg"
run/main_scene="res://Scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="res://Assets/boot_splash.png"
boot_splash/stretch_mode=1
boot_splash/use_filter=true

[audio]

; the CB voice chat's microphone: the input is only opened when the CB Transmit key is first pressed
driver/enable_input=true

[debug]

file_logging/enable_file_logging=false
file_logging/enable_file_logging.pc=false
file_logging/max_log_files=3

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=3

[dotnet]

project/assembly_name="I76.Game"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="forward_plus"

[shader_globals]

i76_car_materials={
"type": "bool",
"value": true
}

i76_car_interiors={
"type": "bool",
"value": true
}

