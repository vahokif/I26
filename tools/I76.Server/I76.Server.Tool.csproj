<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>i26-server</AssemblyName>
    <RootNamespace>I76.ServerTool</RootNamespace>
    <!-- each client's snapshot is written on its own thread: the server GC keeps them from waiting on one heap (64 players: 4 ms of snapshots a tick to 1) -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/I76.Server/I76.Server.csproj" />
  </ItemGroup>
</Project>
